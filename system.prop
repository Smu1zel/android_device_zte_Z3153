# System & Hardware
ro.display.series=ZTE Z3153
ro.product.device=Z3153

# USB and ADB Debugging
# TODO: Do we really need these?
ro.adb.secure=0
ro.debuggable=1
persist.sys.usb.config=adb
sys.usb.config=adb
sys.usb.ffs.aio_compat=1

# Controller
sys.usb.controller=musb-hdrc