# mount point       fstype    device                                                                options

/system             ext4      /dev/block/platform/bootdevice/by-name/system                         ro
/vendor             ext4      /dev/block/platform/bootdevice/by-name/vendor                         ro
/data               f2fs      /dev/block/platform/bootdevice/by-name/userdata                       noatime,nosuid,nodev,discard
/cache              ext4      /dev/block/platform/bootdevice/by-name/cache                          noatime,nosuid,nodev
/boot               emmc      /dev/block/platform/bootdevice/by-name/boot                           defaults
/recovery           emmc      /dev/block/platform/bootdevice/by-name/recovery                       defaults
/misc               emmc      /dev/block/platform/bootdevice/by-name/para                           defaults
/dtbo               emmc      /dev/block/platform/bootdevice/by-name/dtbo                           defaults
/vbmeta             emmc      /dev/block/platform/bootdevice/by-name/vbmeta                         defaults

# Removable Storage
/external_sd        vfat      /dev/block/mmcblk1p1    /dev/block/mmcblk1                            defaults
/usb_otg            vfat      /dev/block/sda1         /dev/block/sda                                defaults