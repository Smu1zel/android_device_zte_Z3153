# mount point       fstype    device                                                                flags

# Dynamic/Logical Partitions
/system             ext4      /dev/block/platform/bootdevice/by-name/system                         flags=display="System";backup=1;wipeingui
/vendor             ext4      /dev/block/platform/bootdevice/by-name/vendor                         flags=display="Vendor";backup=1;wipeingui

# Core Data Partitions
/data               f2fs      /dev/block/platform/bootdevice/by-name/userdata                       flags=fileencryption=aes-256-xts:aes-256-cts;forceencrypt=/dev/block/platform/bootdevice/by-name/metadata;backup=1;wipeingui
/cache              ext4      /dev/block/platform/bootdevice/by-name/cache                          flags=display="Cache";wipeingui

# Boot and Recovery
/boot               emmc      /dev/block/platform/bootdevice/by-name/boot                           flags=display="Boot";backup=1;flashimg=1
/recovery           emmc      /dev/block/platform/bootdevice/by-name/recovery                       flags=display="Recovery";backup=1;flashimg=1
/misc               emmc      /dev/block/platform/bootdevice/by-name/para                           flags=display="Misc";backup=1;flashimg=1

# MediaTek specific partitions (Essential for IMEI/Baseband/MAC backups)
/nvram              emmc      /dev/block/platform/bootdevice/by-name/nvram                          flags=display="NVRAM";backup=1;flashimg=1
/nvdata             ext4      /dev/block/platform/bootdevice/by-name/nvdata                         flags=display="NVDATA";backup=1;subpartitionof=/nvram
/nvcfg              ext4      /dev/block/platform/bootdevice/by-name/nvcfg                          flags=display="NVCFG";backup=1;subpartitionof=/nvram
/protect_f          ext4      /dev/block/platform/bootdevice/by-name/protect1                       flags=display="Protect_F";backup=1;subpartitionof=/nvram
/protect_s          ext4      /dev/block/platform/bootdevice/by-name/protect2                       flags=display="Protect_S";backup=1;subpartitionof=/nvram
/persist            ext4      /dev/block/platform/bootdevice/by-name/persist                        flags=display="Persist";backup=1

# Firmware and Bootloader
/logo               emmc      /dev/block/platform/bootdevice/by-name/logo                           flags=display="Logo";backup=1;flashimg=1
/vbmeta             emmc      /dev/block/platform/bootdevice/by-name/vbmeta                         flags=display="VBMeta";backup=1;flashimg=1
/dtbo               emmc      /dev/block/platform/bootdevice/by-name/dtbo                           flags=display="DTBO";backup=1;flashimg=1
/bootloader         emmc      /dev/block/platform/bootdevice/by-name/lk                             flags=display="Bootloader (lk)";backup=1;flashimg=1
/bootloader2        emmc      /dev/block/platform/bootdevice/by-name/lk2                            flags=display="Bootloader2 (lk2)";backup=1;subpartitionof=/bootloader
/proinfo            emmc      /dev/block/platform/bootdevice/by-name/proinfo                        flags=display="Proinfo";backup=1
/tee1               emmc      /dev/block/platform/bootdevice/by-name/tee1                           flags=display="TEE1";backup=1;flashimg=1
/tee2               emmc      /dev/block/platform/bootdevice/by-name/tee2                           flags=display="TEE2";backup=1;subpartitionof=/tee1

# Removable Storage
/external_sd        vfat      /dev/block/mmcblk1p1    /dev/block/mmcblk1                            flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg            vfat      /dev/block/sdd1         /dev/block/sdd                                flags=display="USB OTG";storage;wipeingui;removable